# GitHub App credentials — from https://YOUR_GHE_HOST/settings/apps/YOUR_APP
APP_ID=123456
WEBHOOK_SECRET=your-webhook-secret

# Private key: paste the contents of the .pem file, with literal \n between lines
# Or set PRIVATE_KEY_PATH and load it from disk instead (requires code change)
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# GitHub Enterprise hostname — no protocol, no trailing slash
GHE_HOST=github.example.com

# GitHub login whose PRs should be auto-approved (e.g. renovate[bot])
APPROVED_USER=renovate[bot]

# Port for the webhook HTTP server
PORT=3000